{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "vitest/globals",
      "vite/client"
    ]
  },
  "include": [
    "tests/v21/**/*.ts",
    "js/v21/**/*.ts",
    "js/v21/**/*.js",
    "tests/v21/**/*.js",
    "vite.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "js/**/*.legacy.js",
    "js/core/consolidated-hotfixes.js",
    "js/app.legacy.bundle.js"
  ]
}
