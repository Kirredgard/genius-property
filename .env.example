# Frontend Firebase configuration (safe to expose in a browser build,
# but restrict the Firebase project by domain/API rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional backend URLs. Leave empty when using same-origin /api routes.
VITE_BILLING_API_URL=
VITE_EMAIL_API_URL=
VITE_INVITATION_API_URL=
VITE_OPS_API_URL=
